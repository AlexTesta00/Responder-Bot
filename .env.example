# Copy this file to .env and fill in the values. Never commit .env.

# Runtime
# One of: development, test, production.
NODE_ENV=development
# Network interface and port the HTTP server listens on.
HOST=0.0.0.0
PORT=3000

# Telegram
# Bot token issued by @BotFather.
TELEGRAM_BOT_TOKEN=
# Random string Telegram sends with every webhook request (32-256 letters,
# digits, underscores or hyphens). Generate one with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=
# Numeric ID of the only Telegram user allowed to use the bot. Send any
# message to @userinfobot to find yours.
TELEGRAM_ALLOWED_USER_ID=

# Anthropic (Claude API)
# API key from console.anthropic.com. A Claude subscription does not include
# API usage: the key is billed separately, per use.
ANTHROPIC_API_KEY=
# Claude model the bot uses; optional, defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5
# Small, inexpensive model for quick steps, such as recognizing whose
# screenshots they are; optional, defaults to claude-haiku-4-5.
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
# Monthly spend limit set on the Claude Console, in dollars (such as 20 or
# 20.50); optional. Each answer then shows how much of it is left, estimated
# from the tokens of every analysis.
ANTHROPIC_MONTHLY_LIMIT_USD=

# Database (MySQL or MariaDB) holding prospect memory
# Required in production. In development leave them empty to keep the memory
# in the process only: it is lost at every restart. On Hostinger, create the
# database in hPanel and use 127.0.0.1 as host.
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
