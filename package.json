{
  "name": "alex-outreach-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI conversation copilot for human-first sales outreach.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts | pino-pretty --ignore pid,hostname --translateTime SYS:HH:MM:ss",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.js",
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "telegram:webhook": "node --env-file-if-exists=.env scripts/telegram-webhook.ts"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "mysql2": "^3.24.4",
    "zod": "^4.6.5"
  }
}
